# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /nfs/stak/users/gemmak/CS461/EnhancingDeformationAnalysisUI/build_gpu && $(CMAKE_COMMAND) -P /nfs/stak/users/gemmak/CS461/EnhancingDeformationAnalysisUI/build_gpu/CMakeFiles/VerifyGlobs.cmake
	cd /nfs/stak/users/gemmak/CS461/EnhancingDeformationAnalysisUI/build_gpu && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

